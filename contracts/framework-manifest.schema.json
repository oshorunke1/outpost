{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oshorunke1/outpost/blob/main/contracts/framework-manifest.schema.json",
  "title": "Outpost framework manifest",
  "description": "Generated by game/scripts/ExportManifest.luau. Lists every service, controller and packet in the game.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "modules", "packets"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "packets": { "type": "array", "items": { "$ref": "#/$defs/packet" } }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "path", "lineCount", "hasInit", "hasStart", "listens"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "kind": { "enum": ["service", "controller"] },
        "path": { "type": "string", "pattern": "^game/src/.+\\.luau$" },
        "lineCount": { "type": "integer", "minimum": 0, "maximum": 700 },
        "hasInit": { "type": "boolean" },
        "hasStart": { "type": "boolean" },
        "listens": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Za-z]*\\.[A-Z][A-Za-z]*$" }
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "payload", "rateLimit"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Za-z]*\\.[A-Z][A-Za-z]*$" },
        "direction": { "enum": ["ClientToServer", "ServerToClient"] },
        "payload": { "type": "string", "minLength": 1 },
        "rateLimit": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["capacity", "refillPerSecond"],
              "properties": {
                "capacity": { "type": "number", "minimum": 1 },
                "refillPerSecond": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          ]
        }
      }
    }
  }
}
