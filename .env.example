# Local development settings. Run `pnpm setup:dev` to copy this file to .env with fresh random secrets.
# .env is git-ignored. Empty values are filled in by setup:dev; nothing secret lives in this file.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
# The game server's API key, shaped opk_<clientId>.<secret>. The key that works is the one the dev seed
# prints (NODE_ENV=development pnpm --filter @outpost/backend seed): it makes a random secret, stores
# only its hash and shows the key once, so paste it here. The seed refuses to run in production.
OUTPOST_GAME_API_KEY=
OUTPOST_DEV_OPERATOR_EMAIL=operator@outpost.local
OUTPOST_DEV_OPERATOR_PASSWORD=
# Integration tests make a throwaway database per test file on the Compose MySQL, and use Redis db 15.
TEST_MYSQL_URL=
TEST_REDIS_URL=redis://127.0.0.1:6379/15
