# Local development settings. Run `pnpm setup:dev` to copy this file to .env with fresh random secrets.
# .env is git-ignored. Empty values are filled in by setup:dev; nothing secret lives in this file.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
# The game server's API key, shaped opk_<clientId>.<secret>. setup:dev fills it with a random value and
# the dev seed (NODE_ENV=development pnpm --filter @outpost/backend seed) stores its hash in MySQL on
# every run, so this key always works locally. Left empty, the seed makes a random key and prints it
# once instead. The seed refuses to run outside development and test.
OUTPOST_GAME_API_KEY=
OUTPOST_DEV_OPERATOR_EMAIL=operator@outpost.local
OUTPOST_DEV_OPERATOR_PASSWORD=
# The telemetry route's per-client token bucket, as <capacity>:<refill per second>. It is separate
# from the bucket the economy and player routes use, so a telemetry flood never blocks a purchase.
TELEMETRY_API_LIMIT=200:150
# Where the Prometheus metrics server (METRICS_PORT, default 9464) listens. Loopback by default, so
# /metrics is never public; the Compose api service sets 0.0.0.0 on its private network.
METRICS_HOST=127.0.0.1
# Integration tests make a throwaway database per test file on the Compose MySQL, and use Redis db 15.
TEST_MYSQL_URL=
TEST_REDIS_URL=redis://127.0.0.1:6379/15
